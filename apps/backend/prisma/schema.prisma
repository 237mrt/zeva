generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  ADMIN
}

enum WorkOrderType {
  IRONING
  PACKAGING
  IRONING_PACKAGING
  PRINTING
  OTHER
}

enum WorkOrderStatus {
  WAITING
  IN_PROGRESS
  READY
  DELIVERED
  CLOSED
  CANCELLED
}

enum PackageType {
  SACK
  BOX
}

model User {
  id           String   @id @default(cuid()) @db.VarChar(30)
  email        String   @unique @db.VarChar(191)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  name         String   @db.VarChar(120)
  role         UserRole @default(ADMIN)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("users")
}

model Customer {
  id          String          @id @default(cuid()) @db.VarChar(30)
  name        String          @db.VarChar(191)
  contactName String?         @map("contact_name") @db.VarChar(120)
  phone       String?         @db.VarChar(40)
  address     String?         @db.VarChar(500)
  notes       String?         @db.Text
  createdAt   DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt   DateTime?       @map("deleted_at") @db.DateTime(3)
  prices      CustomerPrice[]
  workOrders  WorkOrder[]

  @@index([deletedAt])
  @@index([name])
  @@index([contactName])
  @@index([phone])
  @@map("customers")
}

model CustomerPrice {
  id         String        @id @default(cuid()) @db.VarChar(30)
  customerId String        @map("customer_id") @db.VarChar(30)
  type       WorkOrderType
  unitPrice  Decimal       @map("unit_price") @db.Decimal(12, 2)
  createdAt  DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.DateTime(3)
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, type])
  @@index([customerId])
  @@map("customer_prices")
}

model WorkOrder {
  id            String          @id @default(cuid()) @db.VarChar(30)
  customerId    String          @map("customer_id") @db.VarChar(30)
  productName   String          @map("product_name") @db.VarChar(191)
  type          WorkOrderType
  status        WorkOrderStatus @default(WAITING)
  totalQuantity Int             @map("total_quantity")
  unitPrice     Decimal         @map("unit_price") @db.Decimal(12, 2)
  totalAmount   Decimal         @map("total_amount") @db.Decimal(18, 2)
  receivedAt    DateTime        @map("received_at") @db.DateTime(3)
  dueAt         DateTime?       @map("due_at") @db.DateTime(3)
  notes         String?         @db.Text
  createdAt     DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt     DateTime?       @map("deleted_at") @db.DateTime(3)
  customer      Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  packages      WorkOrderPackage[]
  deliveries    Delivery[]

  @@index([customerId])
  @@index([status])
  @@index([type])
  @@index([deletedAt, receivedAt])
  @@index([dueAt])
  @@map("work_orders")
}

model WorkOrderPackage {
  id            String                @id @default(cuid()) @db.VarChar(30)
  workOrderId   String                @map("work_order_id") @db.VarChar(30)
  sequenceNo    Int                   @map("sequence_no")
  type          PackageType
  quantity      Int
  deliveryId    String?               @map("delivery_id") @db.VarChar(30)
  notes         String?               @db.Text
  createdAt     DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime              @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt     DateTime?             @map("deleted_at") @db.DateTime(3)
  workOrder     WorkOrder             @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  delivery      Delivery?             @relation("CurrentDeliveryPackages", fields: [deliveryId], references: [id], onDelete: Restrict)
  deliveryItems DeliveryPackageItem[]

  @@unique([workOrderId, sequenceNo])
  @@index([workOrderId, deletedAt])
  @@index([deliveryId])
  @@map("work_order_packages")
}

model Delivery {
  id              String                @id @default(cuid()) @db.VarChar(30)
  workOrderId     String                @map("work_order_id") @db.VarChar(30)
  totalQuantity   Int                   @map("total_quantity")
  deliveredAt     DateTime              @map("delivered_at") @db.DateTime(3)
  receiverName    String?               @map("receiver_name") @db.VarChar(120)
  notes           String?               @db.Text
  cancelledAt     DateTime?             @map("cancelled_at") @db.DateTime(3)
  createdAt       DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.DateTime(3)
  workOrder       WorkOrder             @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  currentPackages WorkOrderPackage[]    @relation("CurrentDeliveryPackages")
  packageItems    DeliveryPackageItem[]

  @@index([workOrderId, deliveredAt])
  @@index([cancelledAt, deliveredAt])
  @@map("deliveries")
}

model DeliveryPackageItem {
  id                 String           @id @default(cuid()) @db.VarChar(30)
  deliveryId         String           @map("delivery_id") @db.VarChar(30)
  workOrderPackageId String           @map("work_order_package_id") @db.VarChar(30)
  sequenceNo         Int              @map("sequence_no")
  type               PackageType
  quantity           Int
  createdAt          DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  delivery           Delivery         @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  workOrderPackage   WorkOrderPackage @relation(fields: [workOrderPackageId], references: [id], onDelete: Restrict)

  @@unique([deliveryId, workOrderPackageId])
  @@index([workOrderPackageId])
  @@map("delivery_package_items")
}
